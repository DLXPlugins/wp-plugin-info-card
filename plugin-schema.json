{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/DLXPlugins/wp-plugin-info-card/refs/heads/dev/plugin-schema.json",
	"title": "WPPIC Plugin Schema",
	"description": "Schema for WPPIC Plugin Cards export/import (single item).",
	"type": "object",
	"additionalProperties": false,
  
	"$defs": {
	  "intOrStringInt": {
		"oneOf": [
		  { "type": "integer", "minimum": 0 },
		  { "type": "string", "pattern": "^[0-9]+$" }
		]
	  },
	  "percentNumberOrString": {
		"oneOf": [
		  { "type": "number", "minimum": 0, "maximum": 100 },
		  { "type": "string", "pattern": "^(100|[0-9]{1,2})(\\.\\d+)?$" }
		]
	  },
	  "contributorsArray": {
		"type": "array",
		"description": "List of contributors.",
		"items": { "type": "string", "minLength": 1 }
	  },
	  "contributorsString": {
		"type": "string",
		"description": "Comma-separated list of contributor names."
	  }
	},
  
	"properties": {
	  "pluginIconUrl": {
		"type": "string",
		"format": "uri",
		"description": "URL to the plugin icon image."
	  },
	  "pluginBannerUrl": {
		"type": "string",
		"format": "uri",
		"description": "URL to the plugin banner image."
	  },
	  "name": {
		"type": "string",
		"minLength": 1,
		"description": "Display name of the plugin."
	  },
	  "slug": {
		"type": "string",
		"pattern": "^[a-z0-9\\-]+$",
		"description": "Unique plugin slug (lowercase letters, numbers, dashes)."
	  },
	  "shortDescription": {
		"type": "string",
		"description": "Short description of the plugin."
	  },
	  "url": {
		"type": "string",
		"format": "uri",
		"description": "Plugin detail page URL."
	  },
	  "homepage": {
		"type": "string",
		"format": "uri",
		"description": "Homepage URL of the plugin."
	  },
	  "downloadLink": {
		"type": "string",
		"format": "uri",
		"description": "Direct download link for the plugin ZIP. Can also be the same as the homepage URL."
	  },
	  "version": {
		"type": "string",
		"pattern": "^[0-9]+(\\.[0-9]+)*([\\.-][A-Za-z0-9]+)?$",
		"description": "Plugin version string."
	  },
	  "author": {
		"type": "string",
		"description": "Name of the plugin author."
	  },
	  "authorProfile": {
		"type": "string",
		"format": "uri",
		"description": "URL to the plugin author's profile."
	  },
	  "contributors": {
		"description": "Contributors, either as an array or a comma-separated string.",
		"oneOf": [
		  { "$ref": "#/$defs/contributorsArray" },
		  { "$ref": "#/$defs/contributorsString" }
		]
	  },
	  "requires": {
		"type": "string",
		"description": "Minimum required WordPress version."
	  },
	  "tested": {
		"type": "string",
		"description": "Latest WordPress version tested with."
	  },
	  "rating": {
		"description": "Average plugin rating as a percentage.",
		"$ref": "#/$defs/percentNumberOrString"
	  },
	  "numRatings": {
		"description": "Number of ratings.",
		"$ref": "#/$defs/intOrStringInt"
	  },
	  "downloaded": {
		"description": "Total download count.",
		"$ref": "#/$defs/intOrStringInt"
	  },
	  "activeInstalls": {
		"description": "Estimated active install count.",
		"$ref": "#/$defs/intOrStringInt"
	  },
	  "lastUpdated": {
		"type": "string",
		"format": "date",
		"description": "Last updated date (YYYY-MM-DD)."
	  }
	},
  
	"required": [
	  "name",
	  "slug",
	  "shortDescription",
	  "url",
	  "homepage",
	  "downloadLink",
	  "version",
	  "author",
	  "authorProfile",
	  "contributors",
	  "requires",
	  "tested",
	  "rating",
	  "numRatings",
	  "downloaded",
	  "activeInstalls",
	  "lastUpdated"
	]
  }
  