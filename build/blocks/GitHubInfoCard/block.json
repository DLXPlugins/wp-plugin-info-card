    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "preview": {
      "type": "boolean",
      "default": false
    },
    "nameOverride": {
      "type": "string",
      "default": ""
    },
    "loginOverride": {
      "type": "string",
      "default": ""
    },
    "sponsorsUrlOverride": {
      "type": "string",
      "default": ""
    },
    "organizationUrlOverride": {
      "type": "string",
      "default": ""
