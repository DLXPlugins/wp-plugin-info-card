    "buttonBgColor": {
      "type": "string",
      "default": "#1a7f37"
    },
    "buttonBgColorHover": {
      "type": "string",
      "default": "#2c974b"
    },
    "buttonTextColor": {
      "type": "string",
      "default": "#fff"
    },
    "buttonTextColorHover": {
      "type": "string",
      "default": "#fff"
    }
