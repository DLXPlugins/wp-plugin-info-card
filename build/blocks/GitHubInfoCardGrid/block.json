  "attributes": {
    "align": {
      "type": "string",
      "default": "center"
    },
    "horizontalAlign": {
      "type": "string",
      "default": "center"
    },
    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "numChildren": {
      "type": "number",
      "default": 0
    },
    "className": {
      "type": "string",
      "default": ""
    },
    "preview": {
      "type": "boolean",
      "default": false
    },
    "layout": {
      "type": "string",
      "default": "large"
    },
    "showTopBar": {
      "type": "boolean",
      "default": true
    },
    "showAuthorBar": {
      "type": "boolean",
      "default": true
    },
    "showStatsBar": {
      "type": "boolean",
      "default": true
    },
    "showLastUpdated": {
      "type": "boolean",
      "default": true
    },
    "buttonType": {
      "type": "string",
      "default": "github"
    },
    "cols": {
      "type": "number",
      "default": 2
    },
    "colGap": {
      "type": "number",
      "default": 20
    },
    "rowGap": {
      "type": "number",
      "default": 20
    },
    "marginSpacing": {
      "type": "string",
      "default": "none"
