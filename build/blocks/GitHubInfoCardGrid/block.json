    "iconColorHover": {
      "type": "string",
      "default": "#111827"
    },
    "borderColor": {
      "type": "string",
      "default": "#d0d7de"
    },
    "languageBgColor": {
      "type": "string",
      "default": "#24292f"
    },
    "languageTextColor": {
      "type": "string",
      "default": "#fff"
    },
    "sponsorsColor": {
      "type": "string",
      "default": "#bf3989"
